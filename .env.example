# Copy this file to .env and fill in real values. Never commit .env.
# All values here are placeholders — none are real credentials.

# --- Angel One SmartAPI credentials ---
ANGEL_API_KEY=your_api_key_here
ANGEL_CLIENT_CODE=your_client_code_here
ANGEL_PASSWORD_OR_PIN=your_trading_pin_here
ANGEL_TOTP_SECRET=your_totp_base32_secret_here

# --- Trading mode (hard-wired to PAPER for this build; live path raises NotImplementedError) ---
TRADING_MODE=PAPER

# --- Timezone ---
DISPLAY_TIMEZONE=Asia/Kolkata

# --- Paths ---
INSTRUMENT_CACHE_DIR=cache/instruments
LOG_DIR=logs
HOLIDAYS_FILE=config/holidays.json

# --- Logging ---
LOG_LEVEL=INFO

# --- Data store (Phase 2+) ---
TICK_STORE_PATH=data_store/ticks.db

# --- FastAPI dashboard (Phase 8) ---
API_HOST=127.0.0.1
API_PORT=8000

# --- Telegram alerts (pattern/signal notifications) ---
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_or_group_id
